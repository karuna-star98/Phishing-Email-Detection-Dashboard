# Copy to .env (never commit .env). Export these in your shell or use a loader of your choice.
SECRET_KEY=change-me-to-a-long-random-string
PHISH_DB_PATH=data/phishing.db
# Privacy: keep false so raw email bodies are NOT stored in the database.
STORE_EMAIL_BODY=false
ML_ENABLED=true
# Hybrid weights (rule engine vs ML probability)
HYBRID_WEIGHT_RULE=0.6
HYBRID_WEIGHT_ML=0.4
# Domains that belong to YOUR organisation (comma separated) - used for authority-impersonation checks
TRUSTED_DOMAINS=example.com,example.org
RATE_LIMIT_PER_MIN=120
